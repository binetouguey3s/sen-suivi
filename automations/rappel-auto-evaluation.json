{
  "id": "rAppelAutoEval01",
  "name": "Rappel d'auto-évaluation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 10
            }
          ]
        }
      },
      "id": "declencheur-test",
      "name": "Chaque jour à 10 h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/interne/utilisateurs-a-retester",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cle-Interne",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        }
      },
      "id": "utilisateurs-a-retester",
      "name": "Utilisateurs à retester",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/interne/notifications-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Cle-Interne",
              "value": "={{ $env.N8N_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ destinataire_id: $json.id, objet: $json.objet, contenu: $json.contenu, preference: $json.preference }) }}"
      },
      "id": "creer-la-notification-test",
      "name": "Créer la notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ]
    }
  ],
  "connections": {
    "Chaque jour à 10 h": {
      "main": [
        [
          {
            "node": "Utilisateurs à retester",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Utilisateurs à retester": {
      "main": [
        [
          {
            "node": "Créer la notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
