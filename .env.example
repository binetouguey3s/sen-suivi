# Base de données
POSTGRES_DB=sensuivi
POSTGRES_USER=sensuivi
POSTGRES_PASSWORD=change_moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change_moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Protection contre la force brute : blocage après N échecs (par e-mail ou par IP)
CONNEXION_TENTATIVES_MAX=5
CONNEXION_BLOCAGE_MINUTES=15

# Microservice IA
AI_SERVICE_URL=http://ai-service:8001
# Seuil adapté au classificateur actuel par mots-clés pondérés. Avec le
# classificateur par embeddings prévu, la valeur de départ sera 0.55 (docs/SPECIFICATIONS.md).
SEUIL_CONFIANCE_INTENTION=0.70
SEUIL_SIMILARITE_RAG=0.45
CHROMA_PERSIST_DIR=/data/chroma

# Front-end
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:8000/api

# n8n
N8N_WEBHOOK_URL=http://n8n:5678
# Clé partagée entre Django et n8n pour les endpoints /api/interne/ : à générer soi-même
# (ex. python3 -c "import secrets; print(secrets.token_urlsafe(32))"). Ce n'est la clé d'aucun service externe.
N8N_API_KEY=change_moi

# Modèle de langage (Groq) 
LLM_ACTIVE=true
LLM_URL_BASE=https://api.groq.com/openai/v1
LLM_CLE_API=gsk_colle_ta_cle_ici
LLM_MODELE=qwen/qwen3.8-27b
LLM_MODELE_SECOURS=openai/gpt-oss-120b
LLM_DELAI_MAX_SECONDES=8
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=250

# Embeddings
EMBEDDING_MODELE=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NOMBRE_MAX_RESSOURCES=3