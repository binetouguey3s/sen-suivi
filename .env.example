# Base de données
POSTGRES_DB=sensuivi
POSTGRES_USER=sensuivi
POSTGRES_PASSWORD=change_moi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django
DJANGO_SECRET_KEY=change_moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Protection contre la force brute : blocage après N échecs (par e-mail ou par IP)
CONNEXION_TENTATIVES_MAX=5
CONNEXION_BLOCAGE_MINUTES=15

# Microservice IA
AI_SERVICE_URL=http://ai-service:8001
# Attente maximale de Django : doit rester plus long que LLM_DELAI_TOTAL_SECONDES
AI_SERVICE_DELAI_SECONDES=25
# Seuil adapté au classificateur actuel par mots-clés pondérés. Avec le
# classificateur par embeddings prévu, la valeur de départ sera 0.55.
SEUIL_CONFIANCE_INTENTION=0.70
# Réglé pour le modèle multilingue (EMBEDDING_MODELE) : les messages sans rapport
# restent sous 0.38, « je dors mal » trouve « Dormir mieux » à 0.43
SEUIL_SIMILARITE_RAG=0.40
CHROMA_PERSIST_DIR=/data/chroma

# Front-end
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:8000/api

# n8n
N8N_WEBHOOK_URL=http://n8n:5678
# Clé partagée entre Django et n8n pour les endpoints /api/interne/ : à générer soi-même
# (ex. python3 -c "import secrets; print(secrets.token_urlsafe(32))"). Ce n'est la clé d'aucun service externe.
N8N_API_KEY=change_moi
# Rappels doux : journal vide depuis N jours, dernier test plus ancien que N jours,
# et au plus un rappel par utilisateur tous les N jours (désactivables dans les paramètres)
RAPPEL_JOURNAL_JOURS=3
RAPPEL_TEST_JOURS=30
RAPPEL_FREQUENCE_MAX_JOURS=7

# Offre de lancement : mise en relation gratuite pendant 2 mois.
# globale = même date de fin pour tous (OFFRE_DATE_FIN, vide = offre sans fin) ;
# individuelle = OFFRE_DUREE_JOURS à partir de l'inscription de chacun.
OFFRE_MODE=globale
OFFRE_DATE_FIN=2026-11-30
OFFRE_DUREE_JOURS=60
# Après l'offre : accès à la mise en relation par mobile money (prestataire à brancher).
# Le chatbot, l'urgence, le journal, les tests, la bibliothèque, le forum et la
# consultation des profils restent gratuits pour toujours.
ACCES_TARIF_FCFA=2000
ACCES_DUREE_JOURS=30
# Validité du jeton qui rend la mise en relation gratuite après une détresse détectée
URGENCE_JETON_HEURES=24

# Modèle de langage
# Tout fournisseur compatible avec l'API OpenAI (/chat/completions) fonctionne.
# LLM_FOURNISSEURS donne l'ordre de la cascade : si le premier ne répond pas
# (limite de débit, panne), le chatbot essaie le suivant. Chaque préfixe P
# attend P_URL_BASE, P_CLE_API, P_MODELE et, en option, P_MODELE_SECOURS et
# P_EFFORT_RAISONNEMENT (low, medium ou high, pour les modèles qui réfléchissent).
LLM_ACTIVE=true
LLM_FOURNISSEURS=LLM,MISTRAL

# Fournisseur principal : Groq (gratuit, très rapide, multilingue)
LLM_URL_BASE=https://api.groq.com/openai/v1
LLM_CLE_API=gsk_colle_ta_cle_ici
LLM_MODELE=qwen/qwen3.8-27b
LLM_MODELE_SECOURS=openai/gpt-oss-120b
# Effort de raisonnement propre à chaque modèle (valeurs acceptées selon le modèle) :
# qwen3 accepte none, gpt-oss accepte low/medium/high. Sans ce réglage, un modèle qui
# « réfléchit » peut épuiser ses jetons et répondre vide.
LLM_EFFORT_RAISONNEMENT=none
LLM_EFFORT_RAISONNEMENT_SECOURS=low

# Fournisseur de secours : Mistral AI (offre gratuite, excellent en français)
# Clé à créer sur https://console.mistral.ai ; laisser vide pour ne pas l'utiliser
MISTRAL_URL_BASE=https://api.mistral.ai/v1
MISTRAL_CLE_API=
MISTRAL_MODELE=mistral-small-latest

# Autres fournisseurs possibles : ajouter leur préfixe à LLM_FOURNISSEURS
# OPENROUTER_URL_BASE=https://openrouter.ai/api/v1   (modèles « :free » gratuits)
# HUGGINGFACE_URL_BASE=https://router.huggingface.co/v1   (crédits gratuits limités)
# OPENAI_URL_BASE=https://api.openai.com/v1   (payant)

# Délai par appel, et budget total de la cascade
LLM_DELAI_MAX_SECONDES=8
LLM_DELAI_TOTAL_SECONDES=20
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300
# Nombre de derniers échanges transmis au modèle pour suivre la conversation
LLM_HISTORIQUE_MAX=6

# Modération automatique du forum (microservice IA)
# Modèle qui suit une politique écrite et répond en JSON. URL et clé vides :
# celles du fournisseur principal (LLM_URL_BASE, LLM_CLE_API) sont reprises.
# Modèle vide ou indisponible : tout message part en validation humaine.
MODERATION_URL_BASE=
MODERATION_CLE_API=
MODERATION_MODELE=openai/gpt-oss-safeguard-20b
MODERATION_EFFORT_RAISONNEMENT=low
MODERATION_DELAI_SECONDES=8
# En dessous de cette longueur, un message sans problème évident est publié sans appel au modèle
MODERATION_LONGUEUR_MIN=20
# Nombre de décisions gardées en mémoire (messages identiques analysés une seule fois)
MODERATION_CACHE_TAILLE=2000

# Modération du forum (Django) : analyse en arrière-plan, puis suspension
# temporaire au-delà du seuil. Les messages de détresse ne comptent jamais.
MODERATION_ASYNCHRONE=true
MODERATION_SEUIL_INFRACTIONS=3
MODERATION_FENETRE_JOURS=30
MODERATION_SUSPENSION_JOURS=7

# Embeddings
EMBEDDING_MODELE=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NOMBRE_MAX_RESSOURCES=3