# Sen Suivi — microservice IA, version allégée pour l'offre gratuite de Render
# (512 Mo de mémoire) : sans PyTorch, les vecteurs du RAG viennent de l'API
# Mistral. Le Dockerfile principal reste celui du développement local.

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    EMBEDDING_FOURNISSEUR=mistral \
    CHROMA_PERSIST_DIR=/tmp/chroma \
    ANONYMIZED_TELEMETRY=False

COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt

COPY . .

# Pas de disque persistant en gratuit : l'index est reconstruit à chaque
# démarrage depuis le back-end (BACKEND_URL)
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8001} --workers 1"]
